# Production Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_USER=musicuser
DB_PASSWORD=your_secure_password_here
DB_NAME=musicdb
DATABASE_URL=postgresql://musicuser:your_secure_password_here@postgres:5432/musicdb

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-very-secure-secret-key-generate-with-openssl
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# API Keys
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
OPENAI_API_KEY=your_openai_api_key

# CORS Settings
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_NAME=Musigo
NEXT_PUBLIC_APP_DESCRIPTION=Discover music through AI-powered recommendations

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@yourdomain.com

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_key

# Feature Flags
ENABLE_RATE_LIMITING=true
ENABLE_CACHE=true
ENABLE_BACKGROUND_TASKS=true
DEBUG=false
