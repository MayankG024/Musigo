# =============================================================================
# Musigo API Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# CRITICAL: Never commit .env to version control!
# =============================================================================

# Application Settings
# -----------------------------------------------------------------------------
DEBUG=True                    # Set to False in production
PORT=8000                     # API server port
APP_NAME=Musigo
VERSION=0.1.0

# Database Configuration
# -----------------------------------------------------------------------------
# Development (SQLite - single file, no server needed)
DATABASE_URL=sqlite+aiosqlite:///./music_discovery.db

# Production (PostgreSQL - recommended)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# Docker Compose (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://musicuser:musicpass@postgres:5432/musicdb

# Security Settings
# -----------------------------------------------------------------------------
# ⚠️ CRITICAL: Change this to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Development:
# CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Production:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Vector Database (ChromaDB)
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_HTTP_URL=http://localhost:8000  # For ChromaDB server mode
REQUIRE_CHROMA=true                     # Fail startup if Chroma unavailable
DISABLE_EMBEDDINGS=false                # Set true to skip embedding generation
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# External APIs
# -----------------------------------------------------------------------------
# OpenAI (optional - for advanced AI features)
# OPENAI_API_KEY=sk-...

# Spotify API (optional - for music metadata and search)
# Get credentials at: https://developer.spotify.com/dashboard
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Redis Configuration
# -----------------------------------------------------------------------------
# Used for caching, background jobs, and distributed rate limiting
REDIS_URL=redis://localhost:6379/0

# Docker Compose:
# REDIS_URL=redis://redis:6379/0

# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# memory:// - In-memory (development, single instance)
# redis://localhost:6379/1 - Redis (production, multi-instance)
RATE_LIMIT_STORAGE=memory://

# File Storage
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.flac,.m4a,.ogg

# ML Models
# -----------------------------------------------------------------------------
MODEL_DIR=./models

# Logging (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Monitoring (optional)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-sentry-dsn
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# Production Checklist
# =============================================================================
# Before deploying to production, ensure:
# ✅ SECRET_KEY is changed to a strong random value (32+ chars)
# ✅ DEBUG is set to False
# ✅ DATABASE_URL points to PostgreSQL (not SQLite)
# ✅ CORS_ORIGINS is set to your actual domain(s)
# ✅ RATE_LIMIT_STORAGE uses Redis for distributed limiting
# ✅ All sensitive values are in .env (not hardcoded)
# ✅ .env is added to .gitignore
# =============================================================================
